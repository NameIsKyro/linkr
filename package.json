{
  "name": "obsidian-linkr",
  "version": "2.0.2",
  "description": "Linkr builds flexible wiki links for files, headings, and blocks in Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "check": "tsc --noEmit --skipLibCheck",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "wiki-links",
    "embeds",
    "markdown",
    "nameiskyro"
  ],
  "author": "@NameIsKyro",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0"
  }
}
